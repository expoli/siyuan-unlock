+func TestFirstLaunchNoticeAPIUsesInstallationState(t *testing.T) {
+	gin.SetMode(gin.TestMode)
+	originalHomeDir := util.HomeDir
+	util.HomeDir = t.TempDir()
+	t.Cleanup(func() { util.HomeDir = originalHomeDir })
+
+	engine := gin.New()
+	engine.POST("/api/system/getFirstLaunchNotice", getFirstLaunchNotice)
+	engine.POST("/api/system/acknowledgeFirstLaunchNotice", acknowledgeFirstLaunchNotice)
+
+	getAcknowledged := func() bool {
+		recorder := httptest.NewRecorder()
+		request := httptest.NewRequest(http.MethodPost, "http://127.0.0.1/api/system/getFirstLaunchNotice", nil)
+		engine.ServeHTTP(recorder, request)
+		response := &struct {
+			Code int `json:"code"`
+			Data struct {
+				Acknowledged bool `json:"acknowledged"`
+			} `json:"data"`
+		}{}
+		if err := json.Unmarshal(recorder.Body.Bytes(), response); err != nil {
+			t.Fatalf("unmarshal first-launch notice response failed: %v", err)
+		}
+		if response.Code != 0 {
+			t.Fatalf("get first-launch notice failed: %s", recorder.Body.String())
+		}
+		return response.Data.Acknowledged
+	}
+
+	if getAcknowledged() {
+		t.Fatal("new installation was already acknowledged")
+	}
+	recorder := httptest.NewRecorder()
+	request := httptest.NewRequest(http.MethodPost, "http://127.0.0.1/api/system/acknowledgeFirstLaunchNotice", nil)
+	engine.ServeHTTP(recorder, request)
+	response := &struct {
+		Code int `json:"code"`
+	}{}
+	if err := json.Unmarshal(recorder.Body.Bytes(), response); err != nil {
+		t.Fatalf("unmarshal acknowledge response failed: %v", err)
+	}
+	if response.Code != 0 {
+		t.Fatalf("acknowledge first-launch notice failed: %s", recorder.Body.String())
+	}
+	if !getAcknowledged() {
+		t.Fatal("acknowledgement was not returned by the API")
+	}
+}
