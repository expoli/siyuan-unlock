@@ -0,0 +1,78 @@
+import {Dialog} from "../dialog";
+import {isInMobileApp} from "../protyle/util/compatibility";
+import {fetchSyncPost} from "../util/fetch";
+import {isBrowser, isMobile} from "../util/functions";
+import {
+    acknowledgeNotice,
+    getNoticeRemainingSeconds,
+    hasAcknowledgedNotice,
+    isFirstLaunchNoticeEligible,
+} from "./firstLaunchNoticeState";
+
+const RELEASE_URL = "https://github.com/appdev/siyuan-unlock/releases";
+
+const requestNotice = (path: string) => fetchSyncPost(path, {}, undefined, false);
+
+export const openFirstLaunchNotice = async () => {
+    const eligible = isFirstLaunchNoticeEligible({
+        browser: isBrowser(),
+        mobileApp: Boolean(isInMobileApp()),
+        container: window.siyuan.config.system.container,
+        publish: window.siyuan.isPublish,
+    });
+    if (!eligible || await hasAcknowledgedNotice(requestNotice)) {
+        return;
+    }
+
+    return new Promise<void>((resolve) => {
+        const dialog = new Dialog({
+            title: "重要声明",
+            width: isMobile() ? "92vw" : "520px",
+            disableClose: true,
+            hideCloseIcon: true,
+            content: `<div class="b3-dialog__content b3-typography">
+    <p>本项目 <strong>SiYuan Unlock</strong> 为免费开源项目，官方始终免费提供，未授权任何个人或平台收费代售本项目、安装包、激活码或所谓售后服务。</p>
+    <p>如果您通过付费渠道获得本软件，请立即向交易平台申请退款并举报相关卖家，谨防后续收费及安全风险。</p>
+    <p>请仅从官方发布页面获取版本：<br><a href="${RELEASE_URL}" target="_blank" rel="noopener noreferrer">${RELEASE_URL}</a></p>
+    <p>感谢支持开源，共同抵制倒卖。</p>
+    <div class="ft__error fn__none" data-type="noticeError">无法保存确认状态，请重试。</div>
+</div>
+<div class="b3-dialog__action">
+    <button class="b3-button b3-button--text" data-type="noticeAcknowledge" disabled>我已知晓（5）</button>
+</div>`,
+        });
+        const destroy = dialog.destroy.bind(dialog);
+        dialog.destroy = () => undefined;
+
+        const button = dialog.element.querySelector<HTMLButtonElement>("[data-type='noticeAcknowledge']");
+        const errorElement = dialog.element.querySelector<HTMLElement>("[data-type='noticeError']");
+        const startedAt = Date.now();
+        const updateButton = () => {
+            const remaining = getNoticeRemainingSeconds(startedAt, Date.now());
+            if (remaining > 0) {
+                button.textContent = `我已知晓（${remaining}）`;
+                return;
+            }
+            window.clearInterval(timer);
+            button.textContent = "我已知晓";
+            button.disabled = false;
+        };
+        const timer = window.setInterval(updateButton, 250);
+        updateButton();
+
+        button.addEventListener("click", async () => {
+            if (button.disabled) {
+                return;
+            }
+            button.disabled = true;
+            if (!await acknowledgeNotice(requestNotice)) {
+                errorElement.classList.remove("fn__none");
+                button.disabled = false;
+                return;
+            }
+            window.clearInterval(timer);
+            destroy();
+            resolve();
+        });
+    });
+};
diff --git forkSrcPrefix/app/src/boot/firstLaunchNoticeState.test.ts forkDstPrefix/app/src/boot/firstLaunchNoticeState.test.ts
new file mode 100644
index 0000000..c253eb6
--- /dev/null
+++ forkDstPrefix/app/src/boot/firstLaunchNoticeState.test.ts
@@ -0,0 +1,62 @@
+import * as assert from "node:assert/strict";
+import test from "node:test";
+import {
+    NOTICE_ACKNOWLEDGE_API,
+    NOTICE_DELAY_MS,
+    NOTICE_STATUS_API,
+    acknowledgeNotice,
+    getNoticeRemainingSeconds,
+    hasAcknowledgedNotice,
+    isFirstLaunchNoticeEligible,
+} from "./firstLaunchNoticeState";
+
+test("limits the notice to packaged desktop, Android, and iOS clients", () => {
+    assert.equal(isFirstLaunchNoticeEligible({browser: false, mobileApp: false, container: "desktop", publish: false}), true);
+    assert.equal(isFirstLaunchNoticeEligible({browser: true, mobileApp: true, container: "android", publish: false}), true);
+    assert.equal(isFirstLaunchNoticeEligible({browser: true, mobileApp: true, container: "ios", publish: false}), true);
+    assert.equal(isFirstLaunchNoticeEligible({browser: true, mobileApp: false, container: "docker", publish: false}), false);
+    assert.equal(isFirstLaunchNoticeEligible({browser: true, mobileApp: true, container: "harmony", publish: false}), false);
+    assert.equal(isFirstLaunchNoticeEligible({browser: false, mobileApp: false, container: "desktop", publish: true}), false);
+});
+
+test("keeps acknowledgement disabled for five elapsed seconds", () => {
+    assert.equal(NOTICE_DELAY_MS, 5_000);
+    assert.equal(getNoticeRemainingSeconds(1_000, 1_000), 5);
+    assert.equal(getNoticeRemainingSeconds(1_000, 5_999), 1);
+    assert.equal(getNoticeRemainingSeconds(1_000, 6_000), 0);
+    assert.equal(getNoticeRemainingSeconds(1_000, 7_000), 0);
+});
+
+test("reads acknowledgement from the installation-scoped API", async () => {
+    const calls: string[] = [];
+    const acknowledged = await hasAcknowledgedNotice(async (path) => {
+        calls.push(path);
+        return {code: 0, data: {acknowledged: true}};
+    });
+
+    assert.equal(acknowledged, true);
+    assert.deepEqual(calls, [NOTICE_STATUS_API]);
+});
+
+test("writes acknowledgement through the installation-scoped API", async () => {
+    const calls: string[] = [];
+    const acknowledged = await acknowledgeNotice(async (path) => {
+        calls.push(path);
+        return {code: 0};
+    });
+
+    assert.equal(acknowledged, true);
+    assert.deepEqual(calls, [NOTICE_ACKNOWLEDGE_API]);
+});
+
+test("treats API failures as unacknowledged", async () => {
+    assert.equal(await hasAcknowledgedNotice(async () => ({code: 0, data: {acknowledged: false}})), false);
+    assert.equal(await hasAcknowledgedNotice(async () => ({code: -1})), false);
+    assert.equal(await hasAcknowledgedNotice(async () => {
+        throw new Error("read failed");
+    }), false);
+    assert.equal(await acknowledgeNotice(async () => ({code: -1})), false);
+    assert.equal(await acknowledgeNotice(async () => {
+        throw new Error("write failed");
+    }), false);
+});
diff --git forkSrcPrefix/app/src/boot/firstLaunchNoticeState.ts forkDstPrefix/app/src/boot/firstLaunchNoticeState.ts
new file mode 100644
index 0000000..fecf173
--- /dev/null
+++ forkDstPrefix/app/src/boot/firstLaunchNoticeState.ts
@@ -0,0 +1,52 @@
+export const NOTICE_DELAY_MS = 5_000;
+export const NOTICE_STATUS_API = "/api/system/getFirstLaunchNotice";
+export const NOTICE_ACKNOWLEDGE_API = "/api/system/acknowledgeFirstLaunchNotice";
+
+export interface NoticeRuntime {
+    browser: boolean;
+    mobileApp: boolean;
+    container: string;
+    publish: boolean;
+}
+
+interface NoticeAPIResponse {
+    code: number;
+    data?: {
+        acknowledged?: boolean;
+    };
+}
+
+export type NoticeRequest = (path: string) => Promise<NoticeAPIResponse>;
+
+export const isFirstLaunchNoticeEligible = (runtime: NoticeRuntime) => {
+    if (runtime.publish) {
+        return false;
+    }
+    if (!runtime.browser) {
+        return true;
+    }
+    return runtime.mobileApp && ["android", "ios"].includes(runtime.container);
+};
+
+export const getNoticeRemainingSeconds = (startedAt: number, now: number) => {
+    const remaining = Math.ceil((NOTICE_DELAY_MS - (now - startedAt)) / 1_000);
+    return Math.min(NOTICE_DELAY_MS / 1_000, Math.max(0, remaining));
+};
+
+export const hasAcknowledgedNotice = async (request: NoticeRequest) => {
+    try {
+        const response = await request(NOTICE_STATUS_API);
+        return response.code === 0 && response.data?.acknowledged === true;
+    } catch {
+        return false;
+    }
+};
+
+export const acknowledgeNotice = async (request: NoticeRequest) => {
+    try {
+        const response = await request(NOTICE_ACKNOWLEDGE_API);
+        return response.code === 0;
+    } catch {
+        return false;
+    }
+};
